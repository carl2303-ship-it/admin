# =============================================================================
# PADEL HUB — admin.sportsevents.app
# Service role keys: SERVER ONLY (nunca NEXT_PUBLIC_*)
#
# Identity = mesmo projeto Supabase do SportsEvents (Auth + hub_staff + dados SE).
# Não criar projeto Supabase extra só para o hub.
# =============================================================================

# --- SportsEvents Supabase (= Auth do hub + hub_staff + KPIs/dados SE) ---
# Project ref típico: tprbpeacicadsbmvxcqk
NEXT_PUBLIC_SUPABASE_URL=https://tprbpeacicadsbmvxcqk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only: hub_staff, KPIs SE, bridge SE

# Site URL (redirects Auth / Netlify)
NEXT_PUBLIC_SITE_URL=https://admin.sportsevents.app
# Local: http://localhost:3000

# --- Deep-links dos admins legacy ---
NEXT_PUBLIC_BOOST_ADMIN_URL=https://boostpadel.store/admin.html
NEXT_PUBLIC_PADEL1_HQ_URL=https://manager.padel1.app/#super-admin
NEXT_PUBLIC_SPORTSEVENTS_ADMIN_URL=https://sportsevents.app/admin

# --- Boost Store (KPIs + bridge + módulo Fase 2 — projeto Supabase separado) ---
BOOST_SUPABASE_URL=https://YOUR_BOOST_PROJECT.supabase.co
BOOST_SUPABASE_ANON_KEY=eyJ...           # Edge Functions invoke
BOOST_SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only (CRUD módulo Boost)
NEXT_PUBLIC_BOOST_STORE_URL=https://boostpadel.store

# JWT para Edge Functions que exigem Auth Boost user (provision-saas-license).
# Preferência 1: conta bot
# BOOST_EDGE_AUTH_EMAIL=hub-bot@boostpadel.store
# BOOST_EDGE_AUTH_PASSWORD=...
# Preferência 2: user id Boost (generateLink+verifyOtp); ou hub_staff.boost_user_id
# BOOST_EDGE_USER_ID=uuid-do-user-boost

# --- Cron renovação SaaS Tour (Netlify scheduled function diária) ---
# Segredo partilhado entre netlify/functions/saas-renewal-cron e /api/cron/saas-renewals
# SAAS_RENEWAL_CRON_SECRET=gera-um-segredo-longo
# (alternativa aceite: CRON_SECRET)

# --- Padel One / padel1 (manager + player + tour — projeto separado) ---
PADEL1_SUPABASE_URL=https://rqiwnxcexsccguruiteq.supabase.co
PADEL1_SUPABASE_ANON_KEY=eyJ...
PADEL1_SUPABASE_SERVICE_ROLE_KEY=eyJ...  # server-only

# --- Bridge SSO (opcional; se vazio, deep-link sem magic link) ---
# Tempo de vida do link gerado (segundos)
BRIDGE_LINK_TTL_SECONDS=300

# --- Configuração central (/configuracao) — Management API (opcional) ---
# PAT do Supabase (Account → Access Tokens) para actualizar Edge secrets Boost.
# Sem isto: UI + intents + checklist; service role NÃO escreve secrets Edge.
# SUPABASE_ACCESS_TOKEN=sbp_...
# Ou só para Boost:
# BOOST_SUPABASE_ACCESS_TOKEN=sbp_...
# Ref do project Boost (opcional se BOOST_SUPABASE_URL for *.supabase.co)
# BOOST_SUPABASE_PROJECT_REF=your_boost_ref
# Nunca coloques STRIPE_SECRET_KEY neste ficheiro / Netlify admin.

# --- Configuração central — Netlify env visibility (fase 2, opcional) ---
# Personal access token Netlify + account id para listar NOMES de env do site admin.
# Sem isto: o hub mostra só presença runtime (process.env) do catálogo.
# NETLIFY_AUTH_TOKEN=nfp_...
# NETLIFY_ACCOUNT_ID=...
# NETLIFY_SITE_ID=...          # filtrar ao site admin
# NETLIFY_SITE_NAME=...        # deep-link UI (projects/{name}/configuration/env)
# Escrita live de env Netlify a partir do hub = slice seguinte (ainda não).
